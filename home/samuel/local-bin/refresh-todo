#!/usr/bin/env python3
"""Aggregate Trackspace + Nextcloud Deck state into ~/todo.md.

Each project gets a `### Tickets` subsection at the top of its `## <Project>`
section. Projects with Deck-board subsections (configured per project) get
additional `#### Tickets` blocks inside each `### Subsection`.

Credentials come from secret-tool. Failures in one source don't wipe the other.
"""
from __future__ import annotations

import base64
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

TODO = Path.home() / "todo.md"

JIRA_HOST = "trackspace.lhsystems.com"
NC_HOST = "cloud.datatactics.de"
SKIP_STACKS = {"done", "archive", "templates"}
JIRA_STATUS_ORDER = ("In Progress", "To Do", "Backlog", "Open", "On hold")

MEMORY_DIR = Path.home() / ".claude" / "projects" / "-home-samuel" / "memory"
PARKED_GLOB = "parked_*.md"
CHECKBOX_RX = re.compile(r"^\s*-\s*\[\s\]\s+(.+?)\s*$", re.MULTILINE)

# Which tracker projects/boards belong where in todo.md.
#   trackspace:  Jira project keys for this section's `### Tickets`
#   deck:        Deck board names for this section's `### Tickets`
#   subsections: { "<H3 name>": { "deck": [...], "trackspace": [...] }, ... }
#                each entry adds a `#### Tickets` block nested under `### name`
MAPPING: dict[str, dict] = {
    "Fraalliance": {
        "trackspace": ["DHFA"],
        "deck": [],
        "subsections": {
            "OneOps": {"deck": ["OneOps"]},
            "PFA":    {"deck": ["PFA"]},
            "USSP":   {"deck": ["USSP"]},
            "ODD":    {"deck": ["ODD"]},
        },
    },
    "Flightpos": {"trackspace": ["GAF"], "deck": []},
    "Vigilo":    {"trackspace": ["ESPVI"], "deck": []},
    "FLT":       {"trackspace": ["ESPFUEL"], "deck": []},
}


# ── credentials & HTTP ────────────────────────────────────────────────────────

def secret(service: str, host: str, field: str) -> str:
    r = subprocess.run(
        ["secret-tool", "lookup", "service", service, "host", host, "field", field],
        capture_output=True, text=True, check=True,
    )
    val = r.stdout.strip()
    if not val:
        raise RuntimeError(f"empty secret for {service}/{host}/{field}")
    return val


def get_json(url: str, headers: dict) -> object:
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.loads(resp.read())


# ── fetchers ──────────────────────────────────────────────────────────────────

def fetch_jira() -> list[dict]:
    pat = secret("jira", JIRA_HOST, "pat")
    headers = {"Authorization": f"Bearer {pat}"}
    url = (f"https://{JIRA_HOST}/rest/api/2/search"
           f"?jql=assignee%3DcurrentUser()%20AND%20resolution%3DUnresolved"
           f"%20AND%20issuetype%20!%3D%20Epic"
           f"&fields=summary,status,project&maxResults=200")
    return get_json(url, headers).get("issues", [])


def fetch_deck() -> list[dict]:
    user = secret("nextcloud", NC_HOST, "username")
    pw = secret("nextcloud", NC_HOST, "app_password")
    auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
    headers = {"Authorization": f"Basic {auth}", "OCS-APIRequest": "true"}

    boards = get_json(f"https://{NC_HOST}/index.php/apps/deck/api/v1.1/boards", headers)
    cards = []
    for b in boards:
        if b.get("archived"):
            continue
        stacks = get_json(
            f"https://{NC_HOST}/index.php/apps/deck/api/v1.1/boards/{b['id']}/stacks",
            headers,
        )
        for s in stacks:
            if s["title"].strip().lower() in SKIP_STACKS:
                continue
            for c in s.get("cards") or []:
                if c.get("archived") or c.get("done"):
                    continue
                assignees = [
                    a["participant"]["uid"]
                    for a in c.get("assignedUsers", [])
                    if a.get("participant")
                ]
                if user in assignees:
                    cards.append({
                        "board_id": b["id"], "board": b["title"],
                        "stack": s["title"], "id": c["id"], "title": c["title"],
                    })
    return cards


def fetch_parked() -> list[dict]:
    items = []
    if not MEMORY_DIR.exists():
        return items
    for f in sorted(MEMORY_DIR.glob(PARKED_GLOB)):
        text = f.read_text()
        for m in CHECKBOX_RX.finditer(text):
            items.append({"source": f.name, "text": m.group(1)})
    return items


# ── rendering ─────────────────────────────────────────────────────────────────

def _jira_priority(name: str) -> tuple[int, str]:
    try:
        return (JIRA_STATUS_ORDER.index(name), name)
    except ValueError:
        return (len(JIRA_STATUS_ORDER), name)


def render_jira_item(i: dict) -> str:
    key = i["key"]
    status = i["fields"]["status"]["name"]
    summary = i["fields"]["summary"].strip()
    url = f"https://{JIRA_HOST}/browse/{key}"
    return f"- [ ] _{status}_ [{key}]({url}) — {summary}"


def render_deck_item(c: dict) -> str:
    url = f"https://{NC_HOST}/apps/deck/board/{c['board_id']}/card/{c['id']}"
    # Board name lives in the link text so the card id is self-identifying;
    # the stack is shown as the status label.
    return f"- [ ] _{c['stack']}_ [{c['board']} #{c['id']}]({url}) — {c['title']}"


def build_tickets(ts_keys: list[str], deck_boards: list[str],
                  issues: list, cards: list,
                  jira_ok: bool, deck_ok: bool) -> str:
    mine_ts = sorted(
        [i for i in issues if i["fields"]["project"]["key"] in ts_keys],
        key=lambda i: (_jira_priority(i["fields"]["status"]["name"]), i["key"]),
    )
    mine_deck = sorted(
        [c for c in cards if c["board"] in deck_boards],
        key=lambda c: (c["board"], c["stack"], c["title"]),
    )
    total = len(mine_ts) + len(mine_deck)
    lines = [f"_refreshed {datetime.now():%Y-%m-%d %H:%M} · {total} open_", ""]
    if not jira_ok and ts_keys:
        lines.append("_Trackspace fetch failed_")
    if not deck_ok and deck_boards:
        lines.append("_Deck fetch failed_")
    for i in mine_ts:
        lines.append(render_jira_item(i))
    for c in mine_deck:
        lines.append(render_deck_item(c))
    if total == 0 and jira_ok and deck_ok:
        lines.append("_no open tickets_")
    return "\n".join(lines)


def render_parked(items: list[dict]) -> str:
    by_src: dict[str, list[str]] = {}
    for i in items:
        by_src.setdefault(i["source"], []).append(i["text"])
    out = [f"_refreshed {datetime.now():%Y-%m-%d %H:%M}_", ""]
    for src in sorted(by_src):
        label = src.removeprefix("parked_").removesuffix(".md") or src
        out.append(f"**{label}**")
        for t in by_src[src]:
            out.append(f"- [ ] {t}")
        out.append("")
    return "\n".join(out).rstrip()


# ── splicing ──────────────────────────────────────────────────────────────────

def _build_block(level: int, title: str, content: str) -> list[str]:
    out = ["#" * level + " " + title + "\n", "\n"]
    for ln in content.splitlines():
        out.append(ln + "\n")
    out.append("\n")
    return out


def splice_h3_under_h2(text: str, h2: str, h3: str, content: str) -> str:
    """Insert/replace `### h3` inside the `## h2` section.

    - If `## h2` + `### h3` exist: replace the H3 block.
    - If `## h2` exists but the H3 doesn't: insert the H3 immediately after H2.
    - If `## h2` doesn't exist: append a new `## h2` + `### h3` block at the end.
    """
    lines = text.splitlines(keepends=True)
    h2_target = f"## {h2}"
    h3_target = f"### {h3}"
    block = _build_block(3, h3, content)

    h2_idx = next((i for i, ln in enumerate(lines) if ln.strip() == h2_target), None)
    if h2_idx is None:
        return text.rstrip() + f"\n\n## {h2}\n\n" + "".join(block)

    h2_end = next((j for j in range(h2_idx + 1, len(lines))
                   if lines[j].startswith("## ")), len(lines))
    h3_idx = next((j for j in range(h2_idx + 1, h2_end)
                   if lines[j].strip() == h3_target), None)

    if h3_idx is not None:
        end = next(
            (k for k in range(h3_idx + 1, len(lines))
             if lines[k].startswith("### ") or lines[k].startswith("## ")),
            len(lines),
        )
        return "".join(lines[:h3_idx]) + "".join(block) + "".join(lines[end:])

    insert_at = h2_idx + 1
    while insert_at < h2_end and lines[insert_at].strip() == "":
        insert_at += 1
    return "".join(lines[:insert_at]) + "".join(block) + "".join(lines[insert_at:])


def splice_section_at_top(text: str, h2: str, h3: str, content: str) -> str:
    """Place `## h2 > ### h3` right before the first other `## ` heading
    (i.e. at the top of the project list). If `## h2` exists elsewhere, move it."""
    h2_target = f"## {h2}"
    section = f"## {h2}\n\n" + "".join(_build_block(3, h3, content))

    lines = text.splitlines(keepends=True)
    existing = next((i for i, ln in enumerate(lines) if ln.strip() == h2_target), None)
    if existing is not None:
        end = next((j for j in range(existing + 1, len(lines))
                    if lines[j].startswith("## ")), len(lines))
        # Also drop blank lines that immediately preceded the old section, so
        # relocating it doesn't leave (or accumulate) a whitespace gap.
        start = existing
        while start > 0 and lines[start - 1].strip() == "":
            start -= 1
        lines = lines[:start] + ["\n"] + lines[end:] if start > 0 else lines[:start] + lines[end:]

    first_h2 = next((i for i, ln in enumerate(lines) if ln.startswith("## ")), None)
    if first_h2 is None:
        return "".join(lines).rstrip() + "\n\n" + section
    return "".join(lines[:first_h2]) + section + "\n" + "".join(lines[first_h2:])


def remove_section(text: str, h2: str) -> str:
    """Remove the `## h2` section (heading + content until next `## ` or EOF)."""
    h2_target = f"## {h2}"
    lines = text.splitlines(keepends=True)
    idx = next((i for i, ln in enumerate(lines) if ln.strip() == h2_target), None)
    if idx is None:
        return text
    end = next((j for j in range(idx + 1, len(lines)) if lines[j].startswith("## ")),
               len(lines))
    while end > idx + 1 and lines[end - 1].strip() == "":
        end -= 1
    return "".join(lines[:idx]) + "".join(lines[end:])


def splice_h4_under_h3_under_h2(text: str, h2: str, h3: str, h4: str, content: str) -> str:
    """Insert/replace `#### h4` inside `### h3` inside `## h2`.
    No-op if either parent heading is missing."""
    lines = text.splitlines(keepends=True)
    h2_target = f"## {h2}"
    h3_target = f"### {h3}"
    h4_target = f"#### {h4}"

    h2_idx = next((i for i, ln in enumerate(lines) if ln.strip() == h2_target), None)
    if h2_idx is None:
        return text
    h2_end = next((j for j in range(h2_idx + 1, len(lines))
                   if lines[j].startswith("## ")), len(lines))
    h3_idx = next((j for j in range(h2_idx + 1, h2_end)
                   if lines[j].strip() == h3_target), None)
    if h3_idx is None:
        return text
    h3_end = next(
        (k for k in range(h3_idx + 1, h2_end)
         if lines[k].startswith("### ") or lines[k].startswith("## ")),
        h2_end,
    )

    block = _build_block(4, h4, content)
    h4_idx = next((m for m in range(h3_idx + 1, h3_end)
                   if lines[m].strip() == h4_target), None)

    if h4_idx is not None:
        end = next(
            (k for k in range(h4_idx + 1, len(lines))
             if lines[k].startswith("#### ")
             or lines[k].startswith("### ")
             or lines[k].startswith("## ")),
            len(lines),
        )
        return "".join(lines[:h4_idx]) + "".join(block) + "".join(lines[end:])

    insert_at = h3_idx + 1
    while insert_at < h3_end and lines[insert_at].strip() == "":
        insert_at += 1
    return "".join(lines[:insert_at]) + "".join(block) + "".join(lines[insert_at:])


_FENCE_RX = re.compile(r"^\s*(`{3,}|~{3,})")


def normalize_blank_lines(text: str) -> str:
    """Collapse runs of 2+ blank lines to a single blank line, outside fenced
    code blocks (which are preserved verbatim). Trim leading/trailing blanks.
    This is the safety net that stops blank-line accumulation for good."""
    out: list[str] = []
    in_fence = False
    fence_marker = ""
    blank_run = 0
    for ln in text.splitlines():
        m = _FENCE_RX.match(ln)
        if m:
            marker = m.group(1)
            if not in_fence:
                in_fence, fence_marker = True, marker
            elif marker[0] == fence_marker[0] and len(marker) >= len(fence_marker):
                in_fence = False
            out.append(ln)
            blank_run = 0
            continue
        if in_fence:
            out.append(ln)
            continue
        if ln.strip() == "":
            blank_run += 1
            if blank_run == 1:
                out.append("")
        else:
            blank_run = 0
            out.append(ln)
    while out and out[0] == "":
        out.pop(0)
    while out and out[-1] == "":
        out.pop()
    return "\n".join(out) + "\n"


# ── main ──────────────────────────────────────────────────────────────────────

def main() -> int:
    original = TODO.read_text() if TODO.exists() else ""
    text = original

    jira_ok, deck_ok = True, True
    issues, cards = [], []
    try:
        issues = fetch_jira()
    except Exception as e:
        jira_ok = False
        print(f"jira: {e}", file=sys.stderr)
    try:
        cards = fetch_deck()
    except Exception as e:
        deck_ok = False
        print(f"deck: {e}", file=sys.stderr)

    for project, cfg in MAPPING.items():
        text = splice_h3_under_h2(
            text, project, "Tickets",
            build_tickets(
                cfg.get("trackspace", []), cfg.get("deck", []),
                issues, cards, jira_ok, deck_ok,
            ),
        )
        for sub_name, sub_cfg in cfg.get("subsections", {}).items():
            text = splice_h4_under_h3_under_h2(
                text, project, sub_name, "Tickets",
                build_tickets(
                    sub_cfg.get("trackspace", []), sub_cfg.get("deck", []),
                    issues, cards, jira_ok, deck_ok,
                ),
            )

    mapped_ts: set[str] = set()
    mapped_deck: set[str] = set()
    for cfg in MAPPING.values():
        mapped_ts.update(cfg.get("trackspace", []))
        mapped_deck.update(cfg.get("deck", []))
        for sub_cfg in cfg.get("subsections", {}).values():
            mapped_ts.update(sub_cfg.get("trackspace", []))
            mapped_deck.update(sub_cfg.get("deck", []))
    unmapped_issues = [i for i in issues if i["fields"]["project"]["key"] not in mapped_ts]
    unmapped_cards = [c for c in cards if c["board"] not in mapped_deck]

    # Insert auto-only sections at the top of the project list, in reverse order
    # of desired final placement (last insert ends up first).
    parked = fetch_parked()
    if parked:
        text = splice_section_at_top(
            text, "Parked from Claude sessions", "Items", render_parked(parked),
        )
    else:
        text = remove_section(text, "Parked from Claude sessions")

    if unmapped_issues or unmapped_cards:
        text = splice_section_at_top(
            text, "Other tickets", "Tickets",
            build_tickets(
                [i["fields"]["project"]["key"] for i in unmapped_issues],
                [c["board"] for c in unmapped_cards],
                issues, cards, jira_ok, deck_ok,
            ),
        )
    else:
        text = remove_section(text, "Other tickets")

    text = normalize_blank_lines(text)

    if text != original:
        TODO.with_suffix(".md.bak").write_text(original)
        TODO.write_text(text)
        print(f"updated {TODO}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as e:
        print(f"secret-tool failed: {e}", file=sys.stderr)
        sys.exit(1)
